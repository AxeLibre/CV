---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Slides from './Slides.astro';
import { t, type Lang } from '../data/site';

interface Props { project: CollectionEntry<'projects'>; index: number; lang: Lang; }
const { project, index, lang } = Astro.props;
const d = project.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tagline = lang === 'fr' ? d.tagline : d.en.tagline;
const summary = lang === 'fr' ? d.summary : d.en.summary;
---

<a class:list={['card', { 'card--featured': d.featured }]} href={`${base}projets/${project.id}/`} data-reveal>
  <div class="card__media">
    {d.slides.length > 1
      ? <Slides slides={d.slides} />
      : <img src={`${base}media/${d.cover}`} alt={d.coverAlt} loading="lazy" decoding="async" width="1600" height="1000" />}
  </div>
  <span class="card__go" aria-hidden="true"><Icon name="arrow" /></span>
  <div class="card__body">
    <div class="card__meta">
      <span>{String(index + 1).padStart(2, '0')}</span>
      {d.year && <span>{d.year}</span>}
    </div>
    <h3 class="card__title">{d.title}</h3>
    <p class="card__tagline">{tagline}</p>
    {d.featured && <p class="card__tagline" style="font-size:.95rem">{summary}</p>}
    <div class="card__tags">
      {d.stack.slice(0, d.featured ? 5 : 3).map((s) => <span class="chip chip--mono">{s}</span>)}
    </div>
    <span class="sr-only">{t[lang].projects.more}</span>
  </div>
</a>
