---
// Fondu enchaîné d'images (avec léger zoom lent) — remplace les GIF animés.
// Une image peut porter un badge (logo du jeu, etc.) qui apparaît et disparaît avec elle.
// L'animation est pilotée par scripts/motion.ts et ne tourne que si le bloc est visible.
interface Slide { src: string; alt: string; badge?: string; badgeAlt?: string; }
interface Props { slides: Slide[]; eager?: boolean; trigger?: 'auto' | 'hover'; }
// trigger 'hover' : le fondu ne démarre qu'au survol de la carte, et revient à la 1re image ensuite
const { slides, eager = false, trigger = 'auto' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="slides" data-slides data-trigger={trigger}>
  {slides.map((s, i) => (
    <div class:list={['slides__item', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
      <img
        class="slides__img"
        src={`${base}media/${s.src}`}
        alt={i === 0 ? s.alt : ''}
        loading={eager && i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
      {s.badge && (
        <span class="slides__badge">
          <img src={`${base}media/${s.badge}`} alt={s.badgeAlt ?? ''} loading="lazy" decoding="async" />
        </span>
      )}
    </div>
  ))}
  {slides.length > 1 && (
    <div class="slides__dots" aria-hidden="true">
      {slides.map((_, i) => <span class:list={{ 'is-active': i === 0 }}></span>)}
    </div>
  )}
</div>
