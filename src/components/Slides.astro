---
// Fondu enchaîné d'images (avec léger zoom lent) — remplace les GIF animés.
// L'animation est pilotée par scripts/motion.ts et ne tourne que si le bloc est visible.
interface Props { slides: { src: string; alt: string }[]; eager?: boolean; }
const { slides, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="slides" data-slides>
  {slides.map((s, i) => (
    <img
      class:list={['slides__img', { 'is-active': i === 0 }]}
      src={`${base}media/${s.src}`}
      alt={i === 0 ? s.alt : ''}
      aria-hidden={i === 0 ? undefined : 'true'}
      loading={eager && i === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  ))}
  {slides.length > 1 && (
    <div class="slides__dots" aria-hidden="true">
      {slides.map((_, i) => <span class:list={{ 'is-active': i === 0 }}></span>)}
    </div>
  )}
</div>
